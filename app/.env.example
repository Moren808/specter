# Which Solana cluster the app should target.
# Options: localnet | devnet | testnet | mainnet
NEXT_PUBLIC_NETWORK=devnet

# Optional: override the RPC URL. If unset and NEXT_PUBLIC_NETWORK=localnet,
# defaults to http://127.0.0.1:8899; otherwise uses Solana's public RPC.
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Arcium cluster offset. 0 for localnet, 456 for devnet (matches Arcium.toml).
NEXT_PUBLIC_ARCIUM_CLUSTER_OFFSET=456
